// OW 翻译工具技术路线
digraph ow_translation_route {
	bgcolor="#ffffff" compound=true dpi=180 fontcolor="#2a2a2a" fontname="Microsoft YaHei" fontsize=24 label="20 人并发 · 端到端 P95 ≤ 2s" labelloc=t newrank=true nodesep=0.30 pad=0.35 rankdir=TB ranksep=0.62 splines=ortho
	node [color="#2a2a2a" fillcolor="#f4c320" fontcolor="#2a2a2a" fontname="Microsoft YaHei" fontsize=11 margin="0.16,0.12" penwidth=1.8 shape=box style="rounded,filled"]
	edge [arrowsize=0.75 color="#2a2a2a" fontcolor="#2a2a2a" fontname="Microsoft YaHei" fontsize=9 penwidth=1.8]
	subgraph cluster_client {
		bgcolor="#ffffff" color="#2a2a2a" fontcolor="#2a2a2a" label="客户端本地链路 · 每个用户独立执行" margin=18 penwidth=2 style=rounded
		{
			rank=same
			users [label="20 个并发客户端
同步突发触发" fillcolor="#2a2a2a" fontcolor="#ffffff"]
			capture [label="01  截图 + 立即模糊
预算 ≤ 50ms"]
			delta [label="02  感知哈希 + 行差异
未变化：复用可信结果" fillcolor="#ffffff"]
			ocr [label="03  本地 PP-OCRv5
文本 + bbox
P95 ≤ 450ms"]
			quality [label="04  OCR 质量门控
置信度 ≥ 0.90" fillcolor="#ffffff"]
			classify [label="05  bbox 颜色采样
频道分类 + 新增行提取"]
		}
		users -> capture
		capture -> delta
		delta -> ocr
		ocr -> quality
		quality -> classify
	}
	subgraph cluster_gateway {
		bgcolor="#ffffff" color="#2a2a2a" fontcolor="#2a2a2a" label="缓存与中心翻译链路 · 仅发送新增文本" margin=18 penwidth=2 style=rounded
		{
			rank=same
			local_cache [label="06  本地词典 / SQLite
命中即返回 < 10ms" fillcolor="#2a2a2a" fontcolor="#ffffff"]
			api [label="07  FastAPI 网关
认证 · 限流 · Deadline"]
			redis [label="08  Redis 全局缓存
请求合并 < 10ms" fillcolor="#2a2a2a" fontcolor="#ffffff"]
			gpu [label="09  GPU 本地翻译
动态批处理 ≤ 20
P95 ≤ 650ms"]
			render [label="10  原位覆盖译文
端到端 P95 ≤ 2s" fillcolor="#2a2a2a" fontcolor="#ffffff"]
		}
		local_cache -> api
		api -> redis
		redis -> gpu
		gpu -> render
	}
	subgraph cluster_guardrail {
		bgcolor="#ffffff" color="#2a2a2a" fontcolor="#2a2a2a" label="质量回退与可观测性 · 不阻塞首屏" margin=16 penwidth=1.6 style="rounded,dashed"
		{
			rank=same
			glm [label="OCR 低置信度
GLM-OCR 回退 ≤ 700ms
成功后进入步骤 05" fillcolor="#ffffff"]
			metrics [label="Prometheus / Grafana
P50 · P95 · P99
429 · CER · bbox IoU" fillcolor="#2a2a2a" fontcolor="#ffffff"]
			deepseek [label="翻译低置信度
DeepSeek V4 Flash 异步纠错
下一帧修正 · thinking=disabled" fillcolor="#ffffff"]
		}
	}
	classify -> local_cache [lhead=cluster_gateway ltail=cluster_client]
	quality -> glm [constraint=false style=dashed]
	api -> metrics [style=dashed]
	render -> deepseek [style=dashed]
}
