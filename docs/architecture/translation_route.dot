// OW 翻译工具技术路线
digraph ow_translation_route {
	bgcolor="#ffffff" fontcolor="#2a2a2a" fontname="Microsoft YaHei" fontsize=22 label="20 人并发 · 端到端 P95 ≤ 2s" labelloc=t nodesep=0.35 pad=0.30 rankdir=LR ranksep=0.55 splines=polyline
	node [color="#2a2a2a" fillcolor="#f4c320" fontcolor="#2a2a2a" fontname="Microsoft YaHei" fontsize=12 margin="0.14,0.10" penwidth=1.6 shape=box style="rounded,filled"]
	edge [arrowsize=0.75 color="#2a2a2a" fontcolor="#2a2a2a" fontname="Microsoft YaHei" fontsize=10 penwidth=1.6]
	subgraph cluster_client {
		bgcolor="#ffffff" color="#2a2a2a" fontcolor="#2a2a2a" label="客户端（20 实例，本地分摊 OCR）" penwidth=2 style=rounded
		capture [label="截图 + 立即模糊
≤ 50ms"]
		hash [label="感知哈希
画面是否变化？" fillcolor="#ffffff" shape=diamond]
		ocr [label="本地 PP-OCRv5 Mobile
文本 + bbox · P95 ≤ 450ms"]
		confidence [label="OCR 置信度
≥ 0.90？" fillcolor="#ffffff" shape=diamond]
		classify [label="bbox 颜色采样
频道分类 + 新增行提取"]
		local_cache [label="本地词典 / SQLite
热路径 < 10ms" fillcolor="#2a2a2a" fontcolor="#ffffff"]
		render [label="原位覆盖译文
端到端 P95 ≤ 2s" fillcolor="#2a2a2a" fontcolor="#ffffff"]
	}
	subgraph cluster_gateway {
		bgcolor="#ffffff" color="#2a2a2a" fontcolor="#2a2a2a" label="中心翻译网关" penwidth=2 style=rounded
		gateway [label="FastAPI
认证 · 限流 · 100ms deadline"]
		redis [label="Redis 全局缓存
请求合并 < 10ms" fillcolor="#2a2a2a" fontcolor="#ffffff"]
		gpu [label="GPU 本地翻译
动态批处理 ≤ 20
P95 ≤ 650ms"]
	}
	subgraph cluster_fallback {
		bgcolor="#ffffff" color="#2a2a2a" fontcolor="#2a2a2a" label="非关键路径回退" penwidth=1.6 style="rounded,dashed"
		glm [label="GLM-OCR 回退
硬超时 700ms" fillcolor="#ffffff"]
		deepseek [label="DeepSeek V4 Flash
异步纠错 · thinking=disabled" fillcolor="#ffffff"]
	}
	metrics [label="Prometheus / Grafana
P50 · P95 · P99 · 429 · 准确率" fillcolor="#2a2a2a" fontcolor="#ffffff"]
	capture -> hash
	hash -> render [label="未变化 / 缓存命中"]
	hash -> ocr [label="变化"]
	ocr -> confidence
	confidence -> classify [label="是"]
	confidence -> glm [label="否"]
	glm -> classify [label="成功"]
	classify -> local_cache
	local_cache -> render [label="命中"]
	local_cache -> gateway [label="未命中"]
	gateway -> redis
	redis -> render [label="命中"]
	redis -> gpu [label="未命中"]
	gpu -> render [label="首屏结果"]
	gpu -> deepseek [label="低置信度"]
	deepseek -> render [label="后台修正" style=dashed]
	gateway -> metrics [style=dashed]
	ocr -> metrics [style=dashed]
}
